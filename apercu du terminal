    tab.onclick = () => {
      group.querySelectorAll('.subtab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const content = group.nextElementSibling;
      content.querySelectorAll('.pane').forEach(p => p.classList.remove('active'));
      const paneMap = {
        manual: 'qp-manual', python: 'qp-python',
        fund: 'ap-fund', tech: 'ap-tech',
        trades: 'jp-trades', jstats: 'jp-jstats',
        overview: 'pp-overview', risk: 'pp-risk', bt: 'pp-bt'
      };
      const paneId = paneMap[tab.dataset.pane];
      if (paneId) {
        const el = document.getElementById(paneId);
        if (el) el.classList.add('active');
      }
      if (tab.dataset.pane === 'python' && !pyodideReady) initPyodide();
      if (tab.dataset.pane === 'tech') {
        document.getElementById('main-grid').classList.add('fs');
        setTimeout(() => initTradingViewChart(selectedTicker), 350);
