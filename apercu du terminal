/* ═══════════════════════════════════════════════════════════════
   GÉNÉRATION OHLCV (simulation réaliste)
   ═══════════════════════════════════════════════════════════════ */
function generateOHLCV(basePrice, days = 365) {
  const data = [];
  let price = basePrice * 0.85;
  const now = new Date();
  for (let i = days; i >= 0; i--) {
    const date = new Date(now);
    date.setDate(date.getDate() - i);
    if (date.getDay() === 0 || date.getDay() === 6) continue;
    const time = date.toISOString().split('T')[0];
    const volatility = price * 0.018;
    const drift = (Math.random() - 0.48) * volatility;
    const open = price;
    const close = open + drift;
    const high = Math.max(open, close) + Math.random() * volatility * 0.6;
    const low = Math.min(open, close) - Math.random() * volatility * 0.6;
    const volume = Math.floor(5000 + Math.random() * 20000);
    data.push({
      time, open: +open.toFixed(2), high: +high.toFixed(2),
      low: +low.toFixed(2), close: +close.toFixed(2), volume
    });
    price = close;
  }
  return data;
}

/* ═══════════════════════════════════════════════════════════════
