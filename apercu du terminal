async function initPyodide() {
  const statusEl = document.getElementById('py-status');
  const overlay = document.getElementById('loading-overlay');
  try {
    overlay.classList.add('show');
    statusEl.textContent = 'Pyodide: Chargement...';
    pyodide = await loadPyodide({
      indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.24.1/full/'
    });
    await pyodide.runPythonAsync(`
import json, sys, random

class BRVMAPI:
    @staticmethod
    def get_ohlcv_data(ticker, days=100):
        base_prices = {'SNTS': 17500, 'ETIT': 19, 'SIBC': 5400, 'BOAB': 7100, 'PALC': 6800, 'ORAC': 2500}
        base = base_prices.get(ticker, 5000)
        data = []
        price = base * 0.85
        for i in range(days, 0, -1):
            volatility = price * 0.018
            drift = (random.random() - 0.48) * volatility
            open_p = price
            close_p = open_p + drift
            high_p = max(open_p, close_p) + random.random() * volatility * 0.6
            low_p = min(open_p, close_p) - random.random() * volatility * 0.6
            data.append({'time': f'2026-{(i % 12) + 1:02d}-{(i % 28) + 1:02d}',
                        'open': round(open_p, 2), 'high': round(high_p, 2),
                        'low': round(low_p, 2), 'close': round(close_p, 2),
                        'volume': random.randint(5000, 20000)})
            price = close_p
        return data

    @staticmethod
    def create_prediction(author, symbol, direction, target_price, horizon_days, confidence, thesis=""):
        pred = {'id': len(predictions) + 1, 'author': author, 'symbol': symbol,
                'direction': direction, 'target_price': target_price,
                'horizon_days': horizon_days, 'confidence': confidence,
                'thesis': thesis, 'status': 'active'}
        predictions.append(pred)
        return pred

class brvm_api:
    get_ohlcv_data = BRVMAPI.get_ohlcv_data
    create_prediction = BRVMAPI.create_prediction

predictions = []

class OutputCapture:
    def __init__(self): self.output = []
    def write(self, text): self.output.append(text)
    def flush(self): pass
    def get_output(self): return ''.join(self.output)

output_capture = OutputCapture()
sys.stdout = output_capture
    `);
    pyodideReady = true;
    statusEl.textContent = 'Pyodide: ✓ Prêt';
    statusEl.style.color = 'var(--up)';
    overlay.classList.remove('show');
    appendToConsole('✓ Environnement Python prêt', 'success');
    appendToConsole('  Tapez votre code et cliquez sur ▶ EXÉCUTER', 'info');
  } catch (e) {
    statusEl.textContent = 'Pyodide: ✗ Erreur';
    statusEl.style.color = 'var(--down)';
    overlay.classList.remove('show');
    appendToConsole('✗ Erreur Pyodide: ' + e.message, 'error');
  }
}

async function runPythonCode() {
  if (!pyodideReady) {
    appendToConsole('✗ Pyodide pas encore prêt...', 'error');
    return;
  }
  const code = monacoEditor.getValue();
  appendToConsole('\n▶ Exécution du code...', 'info');
  try {
    await pyodide.runPythonAsync('output_capture.output = []');
    await pyodide.runPythonAsync(code);
    const output = await pyodide.runPythonAsync('output_capture.get_output()');
    if (output.trim()) appendToConsole(output, 'success');
    const preds = await pyodide.runPythonAsync('json.dumps(predictions)');
    const newPreds = JSON.parse(preds);
    if (newPreds.length > PREDICTIONS.length) {
      const added = newPreds.length - PREDICTIONS.length;
      appendToConsole(`\n✓ ${added} prédiction(s) ajoutée(s)`, 'success');
      PREDICTIONS = newPreds.map(p => ({
        author: p.author, symbol: p.symbol, dir: p.direction,
        target: p.target_price, horizon: p.horizon_days,
        conf: p.confidence, thesis: p.thesis,
        type: p.direction === 'LONG' ? 'BULLISH' : 'BEARISH'
      }));
      renderPredictions();
      saveState();
    }
  } catch (e) {
    appendToConsole('✗ Erreur: ' + e.message, 'error');
  }
}

function appendToConsole(text, className = '') {
  const cons = document.getElementById('python-console');
  const line = document.createElement('div');
  line.className = 'out-line ' + className;
  line.textContent = text;
  cons.appendChild(line);
  cons.scrollTop = cons.scrollHeight;
}

function loadSavedModels() {
  const models = JSON.parse(localStorage.getItem('brvm_python_models') || '{}');
