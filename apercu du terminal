function makeChart(containerId) {
  const el = document.getElementById(containerId);
  if (!el || !el.offsetHeight) return null;
  return LightweightCharts.createChart(el, {
    layout: {
      background: { type: 'Solid', color: css('--chart-bg') },
      textColor: css('--text')
    },
    grid: {
      vertLines: { color: css('--chart-grid') },
      horzLines: { color: css('--chart-grid') }
    },
    width: el.clientWidth,
    height: el.clientHeight,
    timeScale: { borderColor: css('--border-2') },
    rightPriceScale: { borderColor: css('--border-2') },
    crosshair: { mode: 0 }
  });
}

function buildChart(containerId, type) {
  const c = makeChart(containerId);
  if (!c) return null;
  const s = STOCKS.find(x => x.ticker === selectedTicker);
  const data = generateOHLCV(s.price, type === 'main' ? 365 : 730);
  const up = css('--up'), dn = css('--down'), cy = css('--cyan');

  if (chartType === 'candle' || chartType === 'both') {
    const cs = c.addCandlestickSeries({
      upColor: up, downColor: dn,
      borderUpColor: up, borderDownColor: dn,
      wickUpColor: up, wickDownColor: dn
    });
    cs.setData(data.map(d => ({
      time: d.time, open: d.open, high: d.high, low: d.low, close: d.close
    })));
  }
  if (chartType === 'line' || chartType === 'both') {
    const ls = c.addLineSeries({ color: cy, lineWidth: 2 });
    ls.setData(data.map(d => ({ time: d.time, value: d.close })));
  }
  const vs = c.addHistogramSeries({
    priceFormat: { type: 'volume' },
    priceScaleId: 'vol'
  });
  c.priceScale('vol').applyOptions({ scaleMargins: { top: 0.85, bottom: 0 } });
  vs.setData(data.map(d => ({
    time: d.time, value: d.volume,
    color: d.close >= d.open ? up + '60' : dn + '60'
  })));
  c.timeScale().fitContent();
  return c;
}

