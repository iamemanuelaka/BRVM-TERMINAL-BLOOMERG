<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BRVM TERMINAL · Phase 2 · Final</title>

<!-- ═══════════════════════════════════════════════════════════════
     LIBRAIRIES EXTERNES
     ═══════════════════════════════════════════════════════════════ -->
<script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script src="https://cdn.jsdelivr.net/pyodide/v0.24.1/full/pyodide.js"></script>
<link href="https://cdn.jsdelivr.net/fontsource/css/jetbrains-mono@latest/index.css" rel="stylesheet">
<link rel="stylesheet" data-name="vs/editor/editor.main" href="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/editor/editor.main.css">

<style>
/* ═══════════════════════════════════════════════════════════════
   VARIABLES CSS - THÈMES
   ═══════════════════════════════════════════════════════════════ */

/* Thème SOMBRE (par défaut) */
:root, [data-theme="dark"] {
  --bg: #000000;
  --panel: #0a0a0a;
  --panel-2: #111111;
  --panel-3: #181818;
  --border: #222222;
  --border-2: #333333;
  --text: #d1d4dc;
  --muted: #888888;
  --dim: #666666;
  --accent: #ff9900;
  --cyan: #00e5ff;
  --up: #00ff66;
  --down: #ff3333;
  --chart-bg: #000000;
  --chart-grid: #1a1a1a;
  --shadow: rgba(0,0,0,0.5);
}

/* Thème BLEU NUIT */
[data-theme="blue"] {
  --bg: #0a1628;
  --panel: #0f1e35;
  --panel-2: #152744;
  --panel-3: #1a3154;
  --border: #1e3a5f;
  --border-2: #2a4a70;
  --text: #c5d5e8;
  --muted: #7a8fa6;
  --dim: #5a6f86;
  --accent: #4da6ff;
  --cyan: #00d4ff;
  --up: #00ff88;
  --down: #ff4466;
  --chart-bg: #0a1628;
  --chart-grid: #1e3a5f;
  --shadow: rgba(0,20,50,0.5);
}

/* Thème CLAIR */
[data-theme="light"] {
  --bg: #f5f5f5;
  --panel: #ffffff;
  --panel-2: #fafafa;
  --panel-3: #f0f0f0;
  --border: #e0e0e0;
  --border-2: #d0d0d0;
  --text: #333333;
  --muted: #666666;
  --dim: #999999;
  --accent: #ff6600;
  --cyan: #0088cc;
  --up: #00aa44;
  --down: #cc0000;
  --chart-bg: #ffffff;
  --chart-grid: #e0e0e0;
  --shadow: rgba(0,0,0,0.1);
}

/* ═══════════════════════════════════════════════════════════════
   RESET & BASE
   ═══════════════════════════════════════════════════════════════ */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  height: 100%; width: 100%;
  background: var(--bg); color: var(--text);
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
  user-select: none;
}
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 2px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }

/* ═══════════════════════════════════════════════════════════════
   LAYOUT PRINCIPAL
   ═══════════════════════════════════════════════════════════════ */
.app { display: flex; flex-direction: column; height: 100vh; }

/* ═══════════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════════ */
.header {
  background: var(--panel-2);
  border-bottom: 1px solid var(--border-2);
  padding: 6px 12px;
  display: flex; align-items: center; gap: 16px;
}
.logo {
  background: var(--accent); color: #000;
  font-weight: 700; padding: 2px 8px;
  letter-spacing: 2px; font-size: 11px;
}
.cmd-form {
  flex: 1; display: flex; align-items: center;
  background: var(--bg); border: 1px solid var(--border-2);
  padding: 3px 8px;
}
.cmd-form .prompt { color: var(--accent); font-weight: bold; margin-right: 8px; }
.cmd-form input {
  flex: 1; background: transparent; border: none; outline: none;
  color: var(--cyan); font-family: inherit; font-size: 12px;
  text-transform: uppercase;
}
.cmd-form input::placeholder { color: var(--dim); }
.market-info { display: flex; gap: 12px; font-size: 11px; align-items: center; }
.idx-up { color: var(--up); }
.status { color: var(--muted); }
.open { color: var(--up); font-weight: bold; }
.settings-btn {
  background: var(--panel-3);
  border: 1px solid var(--border-2);
  color: var(--text);
  padding: 4px 8px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.15s;
}
.settings-btn:hover {
  background: var(--accent);
  color: #000;
  border-color: var(--accent);
}

/* ═══════════════════════════════════════════════════════════════
   F-KEYS NAVIGATION
   ═══════════════════════════════════════════════════════════════ */
.fkeys {
  background: var(--panel);
  border-bottom: 1px solid var(--border);
  display: flex; padding: 4px; gap: 3px;
  font-size: 10px;
}
.fkey {
  flex: 1; padding: 4px 6px;
  background: var(--panel-3); color: var(--muted);
  border: 1px solid var(--border-2);
  font-family: inherit; font-weight: bold;
  letter-spacing: 0.5px; cursor: pointer;
  transition: all 0.15s; text-align: center;
}
.fkey:hover { background: var(--border-2); color: var(--accent); }
.fkey.active { background: var(--accent); color: #000; border-color: var(--accent); }
.fkey .fn { font-size: 8px; opacity: 0.75; margin-right: 2px; }

/* ═══════════════════════════════════════════════════════════════
   MAIN GRID
   ═══════════════════════════════════════════════════════════════ */
.main {
  flex: 1;
  display: grid;
  grid-template-columns: 3fr 6fr 3fr;
  gap: 4px; padding: 4px;
  overflow: hidden;
  transition: grid-template-columns 0.3s ease;
}
.main.fs { grid-template-columns: 1fr; }
.main.fs .sidebar-left,
.main.fs .sidebar-right { display: none; }

/* ═══════════════════════════════════════════════════════════════
   PANELS
   ═══════════════════════════════════════════════════════════════ */
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  display: flex; flex-direction: column;
  overflow: hidden;
}
.panel-head {
  background: var(--panel-3);
  color: var(--accent);
  padding: 4px 8px;
  font-weight: bold; font-size: 11px;
  border-bottom: 1px solid var(--border-2);
  display: flex; justify-content: space-between; align-items: center;
}
.panel-head.cyan { color: var(--cyan); }
.panel-head.muted { color: var(--muted); }
.panel-body { flex: 1; overflow-y: auto; padding: 4px; }

/* ═══════════════════════════════════════════════════════════════
   WATCHLIST
   ═══════════════════════════════════════════════════════════════ */
table.watch { width: 100%; border-collapse: collapse; }
table.watch th {
  position: sticky; top: 0;
  background: var(--panel);
  color: var(--dim); font-size: 10px;
  text-align: left; padding: 4px 6px;
  border-bottom: 1px solid var(--border);
  font-weight: normal;
}
table.watch th.r { text-align: right; }
table.watch td { padding: 4px 6px; border-bottom: 1px solid var(--panel-2); }
table.watch tr { cursor: pointer; transition: background 0.1s; }
table.watch tr:hover { background: var(--panel-3); }
table.watch tr.sel { background: var(--panel-3); border-left: 2px solid var(--accent); }
.ticker { color: var(--cyan); font-weight: bold; }
.up { color: var(--up); }
.down { color: var(--down); }
.flat { color: var(--muted); }

/* ═══════════════════════════════════════════════════════════════
   TICKER DETAIL
   ═══════════════════════════════════════════════════════════════ */
.ticker-head {
  padding: 8px;
  display: flex; justify-content: space-between; align-items: flex-start;
  border-bottom: 1px solid var(--border);
}
.ticker-head h1 { color: var(--accent); font-size: 14px; font-weight: bold; }
.ticker-head .name { color: var(--text); font-size: 11px; font-weight: 600; }
.ticker-head .price { color: var(--text); font-size: 16px; font-weight: bold; text-align: right; }
.stats {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 8px; padding: 6px 8px;
  background: var(--panel-2); border-bottom: 1px solid var(--border);
  font-size: 10px;
}
.stats .lbl { color: var(--dim); }
.stats .val { color: var(--text); }
.stats .val.cyan { color: var(--cyan); }

/* ═══════════════════════════════════════════════════════════════
   CHARTS
   ═══════════════════════════════════════════════════════════════ */
.chart-wrap { flex: 1; display: flex; flex-direction: column; padding: 6px; }
.chart-toolbar {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 10px; color: var(--muted); margin-bottom: 4px;
}
.tf-btns { display: flex; gap: 8px; color: var(--cyan); }
.tf-btns span { cursor: pointer; padding: 2px 4px; }
.tf-btns span:hover { color: var(--accent); }
.tf-btns span.active { color: var(--accent); font-weight: bold; }
#chart-container, #chart-big {
  flex: 1; width: 100%;
  background: var(--chart-bg);
  border: 1px solid var(--chart-grid);
}

/* ═══════════════════════════════════════════════════════════════
   FORMS
   ═══════════════════════════════════════════════════════════════ */
.form-row { margin-bottom: 6px; }
.form-row label {
  display: block; color: var(--dim);
  font-size: 10px; margin-bottom: 2px;
  text-transform: uppercase;
}
.form-row input, .form-row select, .form-row textarea {
  width: 100%; background: var(--bg); color: var(--text);
  border: 1px solid var(--border-2);
  padding: 4px 6px; font-family: inherit; font-size: 11px;
  outline: none;
}
.form-row input:focus, .form-row select:focus, .form-row textarea:focus {
  border-color: var(--accent);
}
.form-row textarea { resize: none; height: 50px; }
.btn {
  background: var(--accent); color: #000;
  border: none; padding: 6px; font-family: inherit;
  font-weight: bold; font-size: 11px; cursor: pointer;
  letter-spacing: 1px; width: 100%;
}
.btn:hover { opacity: 0.9; }
.btn-sm { width: auto; padding: 3px 10px; font-size: 10px; }
.btn-up { background: var(--up); }
.btn-dn { background: var(--down); }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }

/* ═══════════════════════════════════════════════════════════════
   FOOTER
   ═══════════════════════════════════════════════════════════════ */
.footer {
  background: var(--panel-2);
  border-top: 1px solid var(--border-2);
  padding: 2px 12px;
  display: flex; justify-content: space-between;
  font-size: 10px; color: var(--muted);
}
.footer .ok { color: var(--up); font-weight: bold; }
.footer .w { color: var(--text); font-weight: bold; }

/* ═══════════════════════════════════════════════════════════════
   VIEWS
   ═══════════════════════════════════════════════════════════════ */
.view { display: none; }
.view.active { display: contents; }

/* ═══════════════════════════════════════════════════════════════
   SUB-TABS
   ═══════════════════════════════════════════════════════════════ */
.subtabs {
  display: flex;
  background: var(--panel-2);
  border-bottom: 1px solid var(--border-2);
  padding: 0 8px;
}
.subtab {
  padding: 6px 14px;
  background: transparent;
  color: var(--muted);
  border: none;
  border-bottom: 2px solid transparent;
  font-family: inherit;
  font-size: 10px; font-weight: bold;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: all 0.15s;
}
.subtab:hover { color: var(--accent); }
.subtab.active { color: var(--accent); border-bottom-color: var(--accent); }
.subtab .ic { margin-right: 4px; font-size: 9px; }

.content { flex: 1; overflow: hidden; display: flex; flex-direction: column; }
.pane { display: none; flex: 1; overflow: hidden; }
.pane.active { display: flex; flex-direction: column; }

/* ═══════════════════════════════════════════════════════════════
   MODAL
   ═══════════════════════════════════════════════════════════════ */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.8);
  display: none; align-items: center; justify-content: center;
  z-index: 9999;
}
.modal-overlay.show { display: flex; }
.modal {
  background: var(--panel);
  border: 1px solid var(--border-2);
  padding: 20px; min-width: 420px;
  box-shadow: 0 10px 40px var(--shadow);
}
.modal h2 {
  color: var(--accent);
  font-size: 14px;
  margin-bottom: 16px;
  letter-spacing: 1px;
}
.modal-section { margin-bottom: 16px; }
.modal-section h3 {
  color: var(--cyan);
  font-size: 11px;
  margin-bottom: 8px;
  text-transform: uppercase;
}
.theme-opts, .chart-opts { display: flex; gap: 8px; }
.theme-btn, .chart-btn {
  flex: 1; padding: 10px;
  background: var(--panel-2);
  border: 2px solid var(--border-2);
  color: var(--text);
  cursor: pointer;
  font-family: inherit;
  font-size: 10px;
  text-align: center;
  transition: all 0.15s;
}
.theme-btn:hover, .chart-btn:hover { border-color: var(--accent); }
.theme-btn.active, .chart-btn.active {
  border-color: var(--accent);
  background: var(--panel-3);
}

/* ═══════════════════════════════════════════════════════════════
   TABLES (TRADES, PORTFOLIO)
   ═══════════════════════════════════════════════════════════════ */
.trade-tbl { width: 100%; border-collapse: collapse; font-size: 10px; }
.trade-tbl th {
  background: var(--panel-3);
  color: var(--accent);
  padding: 6px; text-align: left;
  border-bottom: 1px solid var(--border-2);
  position: sticky; top: 0;
}
.trade-tbl td {
  padding: 6px;
  border-bottom: 1px solid var(--panel-2);
}
.trade-tbl tr:hover { background: var(--panel-3); }
.pnl-pos { color: var(--up); font-weight: bold; }
.pnl-neg { color: var(--down); font-weight: bold; }

/* ═══════════════════════════════════════════════════════════════
   PORTFOLIO CARDS
   ═══════════════════════════════════════════════════════════════ */
.port-sum {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px; padding: 10px;
  background: var(--panel-2);
  border-bottom: 1px solid var(--border);
}
.pcard {
  background: var(--panel-3);
  padding: 10px;
  border: 1px solid var(--border-2);
}
.pcard .lb {
  color: var(--dim);
  font-size: 9px;
  text-transform: uppercase;
  margin-bottom: 4px;
}
.pcard .vl {
  color: var(--accent);
  font-size: 16px;
  font-weight: bold;
}
.pcard .sb {
  color: var(--muted);
  font-size: 9px;
  margin-top: 2px;
}

/* ═══════════════════════════════════════════════════════════════
   PREDICTION CARDS
   ═══════════════════════════════════════════════════════════════ */
.pred-card {
  background: var(--panel-2);
  border: 1px solid var(--border);
  padding: 6px; margin-bottom: 6px;
  font-size: 11px;
  transition: border-color 0.15s;
}
.pred-card:hover { border-color: var(--accent); }
.pred-head { display: flex; justify-content: space-between; font-weight: bold; }
.pred-meta {
  display: flex; justify-content: space-between;
  color: var(--muted); font-size: 10px; margin-top: 4px;
}

/* ═══════════════════════════════════════════════════════════════
   NEWS ITEMS
   ═══════════════════════════════════════════════════════════════ */
.news-item {
  padding: 4px 0 4px 8px;
  border-left: 2px solid var(--border-2);
  font-size: 10px;
  margin-bottom: 6px;
}
.news-item.hot { border-left-color: var(--accent); }
.news-item .time { color: var(--accent); }
.news-item .tag { color: var(--text); font-weight: 600; }
.news-item .txt { color: var(--muted); }

/* ═══════════════════════════════════════════════════════════════
   PYTHON EDITOR
   ═══════════════════════════════════════════════════════════════ */
.py-wrap {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px; padding: 4px;
  overflow: hidden;
}
.py-panel {
  display: flex; flex-direction: column;
  background: var(--panel);
  border: 1px solid var(--border);
  overflow: hidden;
}
.py-toolbar {
  background: var(--panel-3);
  padding: 6px 10px;
  display: flex; align-items: center; gap: 8px;
  border-bottom: 1px solid var(--border-2);
}
.py-toolbar .title {
  color: var(--accent);
  font-weight: bold;
  font-size: 11px;
  letter-spacing: 1px;
}
.py-toolbar button {
  background: var(--panel-2);
  color: var(--text);
  border: 1px solid var(--border-2);
  padding: 3px 10px;
  font-family: inherit;
  font-size: 10px;
  cursor: pointer;
  transition: all 0.15s;
}
.py-toolbar button:hover {
  background: var(--accent);
  color: #000;
  border-color: var(--accent);
}
.py-toolbar button.run {
  background: var(--up);
  color: #000;
  border-color: var(--up);
}
.py-toolbar select {
  background: var(--panel-2);
  color: var(--text);
  border: 1px solid var(--border-2);
  padding: 3px 6px;
  font-family: inherit;
  font-size: 10px;
  outline: none;
}
#monaco-editor-container {
  flex: 1;
  width: 100%;
  background: var(--bg);
}
#python-console {
  flex: 1;
  background: var(--bg);
  color: var(--text);
  padding: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  overflow-y: auto;
  white-space: pre-wrap;
  word-wrap: break-word;
}
#python-console .out-line { margin-bottom: 2px; }
#python-console .out-line.error { color: var(--down); }
#python-console .out-line.success { color: var(--up); }
#python-console .out-line.info { color: var(--cyan); }
#python-console .out-line.warning { color: var(--accent); }

/* ═══════════════════════════════════════════════════════════════
   ANALYST (TRADINGVIEW)
   ═══════════════════════════════════════════════════════════════ */
.analyst-layout {
  display: grid;
  grid-template-columns: 320px 1fr;
  height: 100%;
  gap: 4px;
}
.analyst-card {
  background: var(--panel-2);
  border: 1px solid var(--border);
  padding: 8px;
  margin-bottom: 8px;
}
.analyst-card h4 {
  color: var(--cyan);
  font-size: 11px;
  margin-bottom: 6px;
  padding-bottom: 4px;
  border-bottom: 1px solid var(--border);
}
.metric {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  padding: 4px 0;
  border-bottom: 1px solid var(--panel);
}
.metric .k { color: var(--dim); }
.metric .v { color: var(--text); font-weight: bold; }

.tech-toolbar {
  background: var(--panel-2);
  border-bottom: 1px solid var(--border-2);
  padding: 6px 10px;
  display: flex; align-items: center; gap: 10px;
  flex-wrap: wrap;
}
.tech-toolbar .sym-display {
  background: var(--bg);
  border: 1px solid var(--accent);
  color: var(--accent);
  padding: 3px 10px;
  font-weight: bold;
  font-size: 11px;
  letter-spacing: 1px;
  min-width: 140px;
  text-align: center;
}
.tech-toolbar input.sym-input {
  background: var(--bg);
  border: 1px solid var(--border-2);
  color: var(--cyan);
  padding: 3px 8px;
  font-family: inherit;
  font-size: 11px;
  width: 160px;
  text-transform: uppercase;
}
.tech-toolbar input.sym-input:focus { border-color: var(--accent); outline: none; }
.tech-toolbar button {
  background: var(--panel-3);
  color: var(--text);
  border: 1px solid var(--border-2);
  padding: 3px 10px;
  font-family: inherit;
  font-size: 10px;
  cursor: pointer;
  transition: all 0.15s;
}
.tech-toolbar button:hover {
  background: var(--accent);
  color: #000;
  border-color: var(--accent);
}
.tech-toolbar .sep {
  width: 1px; height: 20px;
  background: var(--border-2);
  margin: 0 4px;
}
.tech-toolbar .preset-group { display: flex; gap: 4px; }
.tech-toolbar .preset-group button {
  font-size: 9px; padding: 3px 6px;
  color: var(--cyan);
}
.tech-toolbar .info-badge {
  margin-left: auto;
  color: var(--dim);
  font-size: 9px;
  font-style: italic;
}
.analyst-chart-wrap {
  flex: 1;
  position: relative;
  background: var(--bg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.analyst-chart-badge {
  position: absolute;
  top: 6px; right: 10px;
  z-index: 10;
  display: flex; gap: 8px; align-items: center;
  pointer-events: none;
}
.analyst-chart-badge .mode {
  background: var(--accent); color: #000;
  padding: 2px 8px; font-size: 9px;
  font-weight: bold; letter-spacing: 1px;
}
.analyst-chart-badge .hint {
  color: var(--dim); font-size: 9px;
  background: rgba(0,0,0,0.7);
  padding: 2px 6px;
}
#tradingview_analyst_chart {
  flex: 1; width: 100%; min-height: 400px;
}

/* ═══════════════════════════════════════════════════════════════
   TOAST & LOADING
   ═══════════════════════════════════════════════════════════════ */
.toast {
  position: fixed; bottom: 30px; right: 20px;
  background: var(--accent); color: #000;
  padding: 8px 16px; font-weight: bold; font-size: 11px;
  opacity: 0; transform: translateY(10px);
  transition: all 0.3s;
  pointer-events: none;
  z-index: 10000;
}
.toast.show { opacity: 1; transform: translateY(0); }

.loading-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.9);
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  color: var(--accent);
  font-size: 14px;
}
.loading-overlay.show { display: flex; }
.loading-overlay .spinner {
  width: 40px; height: 40px;
  border: 3px solid var(--border-2);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16px;
}
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="app">

  <!-- ═══════════════════════════════════════════════════════════════
       HEADER
       ═══════════════════════════════════════════════════════════════ -->
  <div class="header">
    <div class="logo">BRVM TERMINAL</div>
    <form class="cmd-form" id="cmd-form">
      <span class="prompt">&gt;</span>
      <input type="text" id="cmd-input" placeholder="Ticker (ex: SNTS) ou commande...">
    </form>
    <div class="market-info">
      <div>BRVM-10: <span class="idx-up">108.42 (+0.35%)</span></div>
      <div>BRVM-C: <span class="idx-up">215.18 (+0.12%)</span></div>
      <div class="status">MARCHÉ: <span class="open">OUVERT</span></div>
      <div class="status" id="clock">--:--:--</div>
      <button class="settings-btn" id="settings-btn" title="Paramètres">⚙</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       F-KEYS NAVIGATION
       ═══════════════════════════════════════════════════════════════ -->
  <div class="fkeys">
    <button class="fkey active" data-view="equity"><span class="fn">[F1]</span>EQUITY</button>
    <button class="fkey" data-view="news"><span class="fn">[F2]</span>NEWS</button>
    <button class="fkey" data-view="calc"><span class="fn">[F3]</span>CALC</button>
    <button class="fkey" data-view="quant"><span class="fn">[F4]</span>QUANT</button>
    <button class="fkey" data-view="charts"><span class="fn">[F5]</span>CHARTS</button>
    <button class="fkey" data-view="analyst"><span class="fn">[F6]</span>ANALYST</button>
    <button class="fkey" data-view="journal"><span class="fn">[F7]</span>JOURNAL</button>
    <button class="fkey" data-view="portfolio"><span class="fn">[F8]</span>PORT</button>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       MAIN GRID
       ═══════════════════════════════════════════════════════════════ -->
  <div class="main" id="main-grid">

    <!-- SIDEBAR GAUCHE : WATCHLIST -->
    <div class="panel sidebar-left">
      <div class="panel-head">
        <span>WATCHLIST BRVM</span>
        <span style="cursor:pointer" id="refresh-btn">⟳</span>
      </div>
      <div class="panel-body" style="padding:0">
        <table class="watch">
          <thead>
            <tr><th>TICKER</th><th class="r">DERNIER</th><th class="r">VAR%</th></tr>
          </thead>
          <tbody id="wl-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F1 - EQUITY
         ═══════════════════════════════════════════════════════════ -->
    <div class="view active" id="view-equity">
      <div class="panel">
        <div class="ticker-head">
          <div>
            <h1 id="t-ticker">SNTS GP</h1>
            <div class="name" id="t-name">SONATEL SENEGAL</div>
          </div>
          <div>
            <div class="price" id="t-price">17 500 XOF</div>
            <div class="up" id="t-change" style="font-size:11px;font-weight:bold;text-align:right">+1.45%</div>
          </div>
        </div>
        <div class="stats">
          <div><span class="lbl">HAUT: </span><span class="val" id="t-high">17 600</span></div>
          <div><span class="lbl">BAS: </span><span class="val" id="t-low">17 300</span></div>
          <div><span class="lbl">VOL: </span><span class="val" id="t-vol">14 250</span></div>
          <div><span class="lbl">PER: </span><span class="val cyan" id="t-per">14.2x</span></div>
        </div>
        <div class="chart-wrap">
          <div class="chart-toolbar">
            <span>GRAPHIQUE OHLCV</span>
            <div class="tf-btns">
              <span>1M</span><span>3M</span><span>6M</span><span class="active">1A</span>
            </div>
          </div>
          <div id="chart-container"></div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F2 - NEWS
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-news">
      <div class="panel">
        <div class="panel-head muted">
          <span>DÉPÊCHES UEMOA / BRVM / BCEAO</span>
          <span style="color:var(--accent)">LIVE</span>
        </div>
        <div class="panel-body" id="news-full"></div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F3 - CALC
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-calc">
      <div class="panel">
        <div class="panel-head cyan"><span>SIMULATEUR DE RENDEMENT</span></div>
        <div class="panel-body" style="padding:12px">
          <div class="form-row">
            <label>Valeur / Indice</label>
            <select id="calc-ticker">
              <option>SNTS - SONATEL</option>
              <option>ETIT - ECOBANK</option>
              <option>SIBC - SIB CI</option>
              <option>BOAB - BOA BF</option>
              <option>PALC - PALM CI</option>
            </select>
          </div>
          <div class="form-grid">
            <div class="form-row">
              <label>Montant investi (FCFA)</label>
              <input type="number" id="calc-amt" value="1000000">
            </div>
            <div class="form-row">
              <label>Durée (mois)</label>
              <input type="number" id="calc-mo" value="12">
            </div>
          </div>
          <div class="form-row">
            <label>Rendement annualisé hypothétique (%)</label>
            <input type="number" id="calc-rate" value="8" step="0.1">
          </div>
          <button class="btn" id="calc-btn">CALCULER →</button>
          <div style="background:var(--bg);border:1px solid var(--border-2);padding:12px;text-align:center;margin-top:8px">
            <div style="color:var(--dim);font-size:10px">VALEUR PROJETÉE</div>
            <div style="color:var(--accent);font-size:20px;font-weight:bold;margin-top:4px" id="calc-out">—</div>
          </div>
          <div style="color:var(--dim);font-size:9px;margin-top:8px;text-align:center">
            ⚠ Simulation basée sur une hypothèse de rendement constant. Ne constitue pas un conseil en investissement.
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F4 - QUANT (PRÉDICTIONS + PYTHON)
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-quant">
      <div class="panel" style="display:flex;flex-direction:column">
        <div class="subtabs">
          <button class="subtab active" data-pane="manual"><span class="ic">📝</span>PRÉDICTIONS</button>
          <button class="subtab" data-pane="python"><span class="ic">🐍</span>PYTHON</button>
        </div>
        <div class="content">
          <!-- Pane : Prédictions manuelles -->
          <div class="pane active" id="qp-manual">
            <div class="panel-body" style="padding:10px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div>
                  <h4 style="color:var(--accent);font-size:11px;margin-bottom:8px">NOUVELLE PRÉDICTION</h4>
                  <form id="pred-form">
                    <div class="form-row">
                      <label>Nom du trader / modèle</label>
                      <input type="text" id="p-auth" placeholder="ex: AlphaBot_v1" required>
                    </div>
                    <div class="form-grid">
                      <div class="form-row">
                        <label>Valeur ciblée</label>
                        <select id="p-sym" required>
                          <option>SNTS</option><option>ETIT</option><option>SIBC</option>
                          <option>BOAB</option><option>PALC</option><option>SAFC</option>
                          <option>SGBC</option><option>ORAC</option>
                        </select>
                      </div>
                      <div class="form-row">
                        <label>Direction</label>
                        <select id="p-dir">
                          <option value="LONG">LONG (Hausse)</option>
                          <option value="SHORT">SHORT (Baisse)</option>
                        </select>
                      </div>
                    </div>
                    <div class="form-grid">
                      <div class="form-row">
                        <label>Prix cible (FCFA)</label>
                        <input type="number" id="p-target" required>
                      </div>
                      <div class="form-row">
                        <label>Horizon (jours)</label>
                        <input type="number" id="p-horiz" value="30" required>
                      </div>
                    </div>
                    <div class="form-row">
                      <label>Niveau de confiance (%)</label>
                      <input type="number" id="p-conf" min="0" max="100" value="75" required>
                    </div>
                    <div class="form-row">
                      <label>Thèse / Facteurs du modèle</label>
                      <textarea id="p-thesis" placeholder="Justification de la prédiction..."></textarea>
                    </div>
                    <button type="submit" class="btn">ENREGISTRER LA PRÉDICTION</button>
                  </form>
                </div>
                <div>
                  <h4 style="color:var(--cyan);font-size:11px;margin-bottom:8px">
                    PRÉDICTIONS ENREGISTRÉES <span id="pred-count" style="color:var(--accent)">(0 actives)</span>
                  </h4>
                  <div id="pred-list" style="max-height:500px;overflow-y:auto"></div>
                </div>
              </div>
            </div>
          </div>
          <!-- Pane : Python Editor -->
          <div class="pane" id="qp-python">
            <div class="py-wrap">
              <div class="py-panel">
                <div class="py-toolbar">
                  <span class="title">🐍 ÉDITEUR PYTHON</span>
                  <button id="py-run" class="run">▶ EXÉCUTER</button>
                  <button id="py-save">💾 SAUVEGARDER</button>
                  <button id="py-clear">🗑️ EFFACER</button>
                  <select id="py-templates">
                    <option value="">-- Templates --</option>
                    <option value="sma">Moyenne Mobile Simple</option>
                    <option value="rsi">RSI Strategy</option>
                    <option value="momentum">Momentum</option>
                    <option value="mean_reversion">Mean Reversion</option>
                  </select>
                  <select id="py-saved-models">
                    <option value="">-- Modèles sauvegardés --</option>
                  </select>
                </div>
                <div id="monaco-editor-container"></div>
              </div>
              <div class="py-panel">
                <div class="py-toolbar">
                  <span class="title">📟 CONSOLE</span>
                  <button id="console-clear">🗑️ EFFACER</button>
                  <span style="margin-left:auto;color:var(--dim);font-size:9px" id="py-status">Pyodide: Initialisation...</span>
                </div>
                <div id="python-console"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F5 - CHARTS
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-charts">
      <div class="panel">
        <div class="panel-head cyan">
          <span>CHARTS · MULTI-TIMEFRAME</span>
          <span style="color:var(--accent)" id="chart-sym">SNTS</span>
        </div>
        <div class="chart-wrap">
          <div class="chart-toolbar">
            <span>Indicateurs: <span style="color:var(--cyan)">SMA20</span> · <span style="color:var(--accent)">EMA50</span> · <span style="color:var(--up)">BB</span></span>
            <div class="tf-btns">
              <span>1H</span><span>4H</span><span>1D</span><span class="active">1W</span><span>1M</span>
            </div>
          </div>
          <div id="chart-big"></div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F6 - ANALYST (FONDAMENTALE + TECHNIQUE)
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-analyst">
      <div class="panel" style="display:flex;flex-direction:column">
        <div class="subtabs">
          <button class="subtab active" data-pane="fund"><span class="ic">📊</span>FONDAMENTALE</button>
          <button class="subtab" data-pane="tech"><span class="ic">✏️</span>TECHNIQUE</button>
        </div>
        <div class="content">
          <!-- Pane : Fondamentale -->
          <div class="pane active" id="ap-fund">
            <div class="analyst-layout">
              <div class="panel">
                <div class="panel-head">
                  <span id="a-title">SNTS GP</span>
                  <span style="color:var(--cyan)">FONDAMENTAUX</span>
                </div>
                <div class="panel-body" style="padding:8px" id="a-fund"></div>
              </div>
              <div class="panel">
                <div class="panel-head muted"><span>NOTES & COMMENTAIRES</span></div>
                <div class="panel-body" style="padding:8px">
                  <textarea style="width:100%;height:100%;background:var(--bg);color:var(--text);border:1px solid var(--border-2);padding:8px;font-family:inherit;font-size:11px;resize:none" placeholder="Ajoutez vos notes d'analyse fondamentale ici..."></textarea>
                </div>
              </div>
            </div>
          </div>
          <!-- Pane : Technique (TradingView) -->
          <div class="pane" id="ap-tech">
            <div class="analyst-chart-wrap">
              <div class="tech-toolbar">
                <span style="color:var(--dim);font-size:10px">SYMBOLE:</span>
                <span class="sym-display" id="tv-current-symbol">—</span>
                <input type="text" class="sym-input" id="tv-symbol-input" placeholder="Ex: BINANCE:BTCUSDT">
                <button id="tv-load-btn">CHARGER</button>
                <div class="sep"></div>
                <span style="color:var(--dim);font-size:10px">PRESETS BRVM:</span>
                <div class="preset-group">
                  <button data-preset="SNTS">SNTS</button>
                  <button data-preset="ETIT">ETIT</button>
                  <button data-preset="ORAC">ORAC</button>
                  <button data-preset="BOAB">BOAB</button>
                  <button data-preset="PALC">PALC</button>
                </div>
                <div class="sep"></div>
                <span style="color:var(--dim);font-size:10px">TEST:</span>
                <div class="preset-group">
                  <button data-preset="BINANCE:BTCUSDT" style="color:var(--accent)">BTC</button>
                  <button data-preset="FX:EURUSD" style="color:var(--accent)">EUR/USD</button>
                  <button data-preset="NASDAQ:AAPL" style="color:var(--accent)">AAPL</button>
                  <button data-preset="TVC:GOLD" style="color:var(--accent)">OR</button>
                </div>
                <span class="info-badge">✏️ Barre d'outils à gauche du graphique</span>
              </div>
              <div class="analyst-chart-badge">
                <span class="mode">MODE ANALYSE TECHNIQUE</span>
                <span class="hint">✏️ Cliquez sur les crayons à gauche pour tracer</span>
              </div>
              <div id="tradingview_analyst_chart"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F7 - TRADE JOURNAL
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-journal">
      <div class="panel" style="display:flex;flex-direction:column">
        <div class="subtabs">
          <button class="subtab active" data-pane="trades"><span class="ic">📋</span>TRANSACTIONS</button>
          <button class="subtab" data-pane="jstats"><span class="ic">📊</span>STATISTIQUES</button>
        </div>
        <div class="content">
          <!-- Pane : Transactions -->
          <div class="pane active" id="jp-trades">
            <div style="padding:10px">
              <div style="display:grid;grid-template-columns:1fr 2fr;gap:12px">
                <div>
                  <h4 style="color:var(--accent);font-size:11px;margin-bottom:8px">NOUVELLE TRANSACTION</h4>
                  <form id="trade-form">
                    <div class="form-row">
                      <label>Date</label>
                      <input type="date" id="tr-date" required>
                    </div>
                    <div class="form-grid">
                      <div class="form-row">
                        <label>Ticker</label>
                        <select id="tr-tick" required>
                          <option>SNTS</option><option>ETIT</option><option>SIBC</option>
                          <option>BOAB</option><option>PALC</option><option>SAFC</option>
                          <option>SGBC</option><option>ORAC</option>
                        </select>
                      </div>
                      <div class="form-row">
                        <label>Type</label>
                        <select id="tr-type">
                          <option value="BUY">ACHAT</option>
                          <option value="SELL">VENTE</option>
                        </select>
                      </div>
                    </div>
                    <div class="form-grid">
                      <div class="form-row">
                        <label>Quantité</label>
                        <input type="number" id="tr-qty" min="1" required>
                      </div>
                      <div class="form-row">
                        <label>Prix (FCFA)</label>
                        <input type="number" id="tr-price" step="0.01" required>
                      </div>
                    </div>
                    <div class="form-row">
                      <label>Frais (FCFA)</label>
                      <input type="number" id="tr-fees" value="0" step="0.01">
                    </div>
                    <div class="form-row">
                      <label>Stratégie / Notes</label>
                      <textarea id="tr-notes" placeholder="Raison du trade, setup, émotion..."></textarea>
                    </div>
                    <button type="submit" class="btn">ENREGISTRER LA TRANSACTION</button>
                  </form>
                </div>
                <div>
                  <h4 style="color:var(--cyan);font-size:11px;margin-bottom:8px">HISTORIQUE DES TRANSACTIONS</h4>
                  <div style="max-height:500px;overflow-y:auto">
                    <table class="trade-tbl">
                      <thead>
                        <tr>
                          <th>DATE</th>
                          <th>TICKER</th>
                          <th>TYPE</th>
                          <th>QTY</th>
                          <th>PRIX</th>
                          <th>TOTAL</th>
                          <th>P&L</th>
                        </tr>
                      </thead>
                      <tbody id="trade-list"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Pane : Stats -->
          <div class="pane" id="jp-jstats">
            <div style="padding:12px">
              <div class="port-sum">
                <div class="pcard">
                  <div class="lb">P&L TOTAL</div>
                  <div class="vl" id="st-pnl">0 FCFA</div>
                  <div class="sb">Résultat cumulé</div>
                </div>
                <div class="pcard">
                  <div class="lb">NB TRADES</div>
                  <div class="vl" id="st-cnt">0</div>
                  <div class="sb">Transactions</div>
                </div>
                <div class="pcard">
                  <div class="lb">WIN RATE</div>
                  <div class="vl" id="st-wr">0%</div>
                  <div class="sb">Ratio de réussite</div>
                </div>
                <div class="pcard">
                  <div class="lb">PROFIT FACTOR</div>
                  <div class="vl" id="st-pf">0.00</div>
                  <div class="sb">Gain moy. / Perte moy.</div>
                </div>
              </div>
              <div style="margin-top:16px">
                <h4 style="color:var(--accent);font-size:11px;margin-bottom:8px">DÉTAILS PAR TICKER</h4>
                <div id="st-by-ticker"></div>
              </div>
              <div style="margin-top:16px;color:var(--muted);font-size:10px">
                <p><strong>Formules utilisées :</strong></p>
                <p style="margin-top:4px">• P&L = (Prix vente - Prix moyen achat) × Quantité - Frais</p>
                <p>• Win Rate = Nombre de trades gagnants / Nombre total de trades</p>
                <p>• Profit Factor = Moyenne des gains / Moyenne des pertes</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         F8 - PORTFOLIO (VUE D'ENSEMBLE + RISQUE + BACKTEST)
         ═══════════════════════════════════════════════════════════ -->
    <div class="view" id="view-portfolio">
      <div class="panel" style="display:flex;flex-direction:column">
        <div class="subtabs">
          <button class="subtab active" data-pane="overview"><span class="ic">💼</span>VUE D'ENSEMBLE</button>
          <button class="subtab" data-pane="risk"><span class="ic">⚠️</span>RISQUE & VaR</button>
          <button class="subtab" data-pane="bt"><span class="ic">🔬</span>BACKTESTING</button>
        </div>
        <div class="content">
          <!-- Pane : Vue d'ensemble -->
          <div class="pane active" id="pp-overview">
            <div style="padding:12px">
              <div class="port-sum">
                <div class="pcard">
                  <div class="lb">VALEUR TOTALE</div>
                  <div class="vl" id="pv-val">0 FCFA</div>
                  <div class="sb">Portfolio actuel</div>
                </div>
                <div class="pcard">
                  <div class="lb">P&L NON RÉALISÉ</div>
                  <div class="vl" id="pv-pnl">0 FCFA</div>
                  <div class="sb">Gain/perte latent</div>
                </div>
                <div class="pcard">
                  <div class="lb">BETA</div>
                  <div class="vl" id="pv-beta">0.00</div>
                  <div class="sb">Sensibilité au marché</div>
                </div>
                <div class="pcard">
                  <div class="lb">SHARPE RATIO</div>
                  <div class="vl" id="pv-sharpe">0.00</div>
                  <div class="sb">Rendement / risque</div>
                </div>
              </div>
              <div style="margin-top:16px">
                <h4 style="color:var(--accent);font-size:11px;margin-bottom:8px">COMPOSITION DU PORTFOLIO</h4>
                <div id="port-hold"></div>
              </div>
              <div style="margin-top:16px">
                <h4 style="color:var(--accent);font-size:11px;margin-bottom:8px">RÉPARTITION SECTORIELLE</h4>
                <div id="port-sector"></div>
              </div>
            </div>
          </div>
          <!-- Pane : Risque -->
