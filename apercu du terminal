function switchView(viewId) {
  document.querySelectorAll('.fkey').forEach(b =>
    b.classList.toggle('active', b.dataset.view === viewId));
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  const target = document.getElementById('view-' + viewId);
  if (target) target.classList.add('active');

  const mainGrid = document.getElementById('main-grid');
  mainGrid.classList.remove('fs');

  if (viewId === 'analyst') renderAnalyst();
  if (viewId === 'journal') renderTrades();
  if (viewId === 'portfolio') updatePortfolio();
  if (viewId === 'charts' && chartBig) setTimeout(() => rebuildCharts(), 50);
}

document.querySelectorAll('.fkey').forEach(btn => {
  btn.onclick = () => switchView(btn.dataset.view);
});

document.addEventListener('keydown', e => {
  if (['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) return;
  const map = {
    F1: 'equity', F2: 'news', F3: 'calc', F4: 'quant',
    F5: 'charts', F6: 'analyst', F7: 'journal', F8: 'portfolio'
  };
