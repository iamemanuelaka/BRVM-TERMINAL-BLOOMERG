function updateTradeStats() {
  const sells = TRADES.filter(t => t.type === 'SELL' && t.pnl);
  const totalPnl = sells.reduce((s, t) => s + t.pnl, 0);
  const wins = sells.filter(t => t.pnl > 0);
  const losses = sells.filter(t => t.pnl < 0);
  const winRate = sells.length ? (wins.length / sells.length * 100) : 0;
  const avgWin = wins.length ? wins.reduce((s, t) => s + t.pnl, 0) / wins.length : 0;
  const avgLoss = losses.length ? Math.abs(losses.reduce((s, t) => s + t.pnl, 0) / losses.length) : 1;
  const profitFactor = avgLoss > 0 ? avgWin / avgLoss : 0;

  document.getElementById('st-pnl').textContent = totalPnl.toLocaleString('fr-FR') + ' FCFA';
  document.getElementById('st-pnl').style.color = totalPnl >= 0 ? 'var(--up)' : 'var(--down)';
  document.getElementById('st-cnt').textContent = TRADES.length;
  document.getElementById('st-wr').textContent = winRate.toFixed(1) + '%';
  document.getElementById('st-pf').textContent = profitFactor.toFixed(2);

  // Stats par ticker
  const byTicker = {};
  TRADES.forEach(t => {
    if (!byTicker[t.ticker]) byTicker[t.ticker] = { pnl: 0, trades: 0 };
    byTicker[t.ticker].trades++;
    if (t.pnl) byTicker[t.ticker].pnl += t.pnl;
  });
  const tbl = document.getElementById('st-by-ticker');
  const entries = Object.entries(byTicker);
  if (!entries.length) {
    tbl.innerHTML = '<p style="color:var(--muted);font-size:11px">Aucune donnée</p>';
  } else {
    tbl.innerHTML = `
      <table class="trade-tbl">
        <thead><tr><th>TICKER</th><th>TRADES</th><th>P&L</th></tr></thead>
        <tbody>${entries.map(([tk, d]) => `
          <tr>
            <td style="color:var(--cyan);font-weight:bold">${tk}</td>
            <td>${d.trades}</td>
            <td class="${d.pnl >= 0 ? 'pnl-pos' : 'pnl-neg'}">${d.pnl ? ((d.pnl >= 0 ? '+' : '') + d.pnl.toLocaleString('fr-FR')) : '—'}</td>
          </tr>
        `).join('')}</tbody>
      </table>
    `;
  }
}

/* ═══════════════════════════════════════════════════════════════
   PORTFOLIO
   ═══════════════════════════════════════════════════════════════ */
function updatePortfolio() {
  // Calculer positions actuelles
  const positions = {};
  TRADES.forEach(t => {
    if (!positions[t.ticker]) positions[t.ticker] = { qty: 0, cost: 0 };
    if (t.type === 'BUY') {
      positions[t.ticker].qty += t.qty;
      positions[t.ticker].cost += t.qty * t.price;
    } else {
      positions[t.ticker].qty -= t.qty;
    }
  });

  let totalValue = 0, totalCost = 0;
  const holdings = [];
  const sectorMap = {};

  Object.keys(positions).forEach(tk => {
    const pos = positions[tk];
    if (pos.qty > 0) {
      const st = STOCKS.find(x => x.ticker === tk);
      const currentPrice = st ? st.price : pos.cost / pos.qty;
      const currentValue = pos.qty * currentPrice;
      const pnl = currentValue - pos.cost;
      totalValue += currentValue;
      totalCost += pos.cost;
      holdings.push({
        ticker: tk, qty: pos.qty, avgPrice: pos.cost / pos.qty,
        currentValue, pnl, pnlPct: pos.cost > 0 ? (pnl / pos.cost * 100) : 0,
        sector: st ? st.sector : 'Autre', beta: st ? st.beta : 1
      });
      if (st) {
        if (!sectorMap[st.sector]) sectorMap[st.sector] = 0;
        sectorMap[st.sector] += currentValue;
      }
    }
  });

  const unrealizedPnl = totalValue - totalCost;

  // Métriques
  document.getElementById('pv-val').textContent = totalValue.toLocaleString('fr-FR') + ' FCFA';
  document.getElementById('pv-pnl').textContent = (unrealizedPnl >= 0 ? '+' : '') + unrealizedPnl.toLocaleString('fr-FR') + ' FCFA';
  document.getElementById('pv-pnl').style.color = unrealizedPnl >= 0 ? 'var(--up)' : 'var(--down)';

  // Beta pondéré
  const beta = holdings.length ?
    holdings.reduce((s, h) => s + h.beta * (h.currentValue / totalValue), 0) : 0;
  document.getElementById('pv-beta').textContent = beta.toFixed(2);

  // Sharpe (simplifié)
  const portfolioReturn = totalCost > 0 ? (unrealizedPnl / totalCost) : 0;
  const riskFree = 0.03;
  const vol = 0.15;
  const sharpe = vol > 0 ? (portfolioReturn - riskFree) / vol : 0;
  document.getElementById('pv-sharpe').textContent = sharpe.toFixed(2);

  // Holdings table
  const holdEl = document.getElementById('port-hold');
  if (!holdings.length) {
    holdEl.innerHTML = '<p style="color:var(--muted);font-size:11px">Aucune position ouverte. Ajoutez des transactions dans le TRADE JOURNAL (F7).</p>';
  } else {
    holdEl.innerHTML = `
      <table class="trade-tbl">
        <thead><tr><th>TICKER</th><th>QTY</th><th>PRIX MOYEN</th><th>VALEUR</th><th>P&L</th><th>P&L %</th></tr></thead>
        <tbody>${holdings.map(h => `
          <tr>
            <td style="color:var(--cyan);font-weight:bold">${h.ticker}</td>
            <td>${h.qty}</td>
            <td>${h.avgPrice.toLocaleString('fr-FR')}</td>
            <td>${h.currentValue.toLocaleString('fr-FR')}</td>
            <td class="${h.pnl >= 0 ? 'pnl-pos' : 'pnl-neg'}">${h.pnl >= 0 ? '+' : ''}${h.pnl.toLocaleString('fr-FR')}</td>
            <td class="${h.pnlPct >= 0 ? 'pnl-pos' : 'pnl-neg'}">${h.pnlPct >= 0 ? '+' : ''}${h.pnlPct.toFixed(2)}%</td>
          </tr>
        `).join('')}</tbody>
      </table>
    `;
  }

  // Répartition sectorielle
  const sectorEl = document.getElementById('port-sector');
  const sectorEntries = Object.entries(sectorMap);
  if (!sectorEntries.length) {
    sectorEl.innerHTML = '<p style="color:var(--muted);font-size:11px">Aucune donnée</p>';
  } else {
    sectorEl.innerHTML = `
      <table class="trade-tbl">
        <thead><tr><th>SECTEUR</th><th>VALEUR</th><th>% PORTFOLIO</th></tr></thead>
        <tbody>${sectorEntries.map(([sec, val]) => `
          <tr>
            <td style="color:var(--cyan);font-weight:bold">${sec}</td>
            <td>${val.toLocaleString('fr-FR')}</td>
            <td>${totalValue > 0 ? (val / totalValue * 100).toFixed(1) : 0}%</td>
          </tr>
        `).join('')}</tbody>
      </table>
    `;
  }

  // Risk metrics
  const var95 = totalValue * vol * 1.645 / Math.sqrt(252);
  document.getElementById('rk-var').textContent = Math.round(var95).toLocaleString('fr-FR') + ' FCFA';
  document.getElementById('rk-vol').textContent = (vol * 100).toFixed(1) + '%';
  document.getElementById('rk-dd').textContent = '-' + (5 + Math.random() * 15).toFixed(1) + '%';
  document.getElementById('rk-wacc').textContent = (8 + Math.random() * 4).toFixed(1) + '%';
}

/* ═══════════════════════════════════════════════════════════════
   SCENARIO SIMULATOR
   ═══════════════════════════════════════════════════════════════ */
function runScenario() {
  const shock = parseFloat(document.getElementById('sc-shock').value) / 100;
  const horizon = parseInt(document.getElementById('sc-horizon').value);
  const positions = {};
  TRADES.forEach(t => {
    if (!positions[t.ticker]) positions[t.ticker] = { qty: 0, cost: 0 };
    if (t.type === 'BUY') { positions[t.ticker].qty += t.qty; positions[t.ticker].cost += t.qty * t.price; }
    else positions[t.ticker].qty -= t.qty;
  });

  let currentValue = 0, totalCost = 0;
  Object.keys(positions).forEach(tk => {
    const pos = positions[tk];
    if (pos.qty > 0) {
      const st = STOCKS.find(x => x.ticker === tk);
      const price = st ? st.price : pos.cost / pos.qty;
      const beta = st ? st.beta : 1;
      currentValue += pos.qty * price * (1 + shock * beta);
      totalCost += pos.cost;
    }
  });

  const pnl = currentValue - totalCost;
  const pnlPct = totalCost > 0 ? (pnl / totalCost * 100) : 0;

  document.getElementById('sc-result').innerHTML = `
    <div style="margin-bottom:8px"><strong style="color:var(--accent)">Choc de ${shock * 100}% sur ${horizon} jours</strong></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Valeur actuelle</span><b>${totalCost.toLocaleString('fr-FR')}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Valeur après choc</span><b style="color:${pnl >= 0 ? 'var(--up)' : 'var(--down)'}">${currentValue.toFixed(0).toLocaleString('fr-FR')}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>P&L estimé</span><b class="${pnl >= 0 ? 'pnl-pos' : 'pnl-neg'}">${pnl >= 0 ? '+' : ''}${pnl.toFixed(0).toLocaleString('fr-FR')}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0"><span>Variation</span><b class="${pnlPct >= 0 ? 'pnl-pos' : 'pnl-neg'}">${pnlPct >= 0 ? '+' : ''}${pnlPct.toFixed(2)}%</b></div>
  `;
  toast('✓ Simulation terminée');
}

/* ═══════════════════════════════════════════════════════════════
   BACKTESTING
   ═══════════════════════════════════════════════════════════════ */
function runBacktest() {
  const capital = parseFloat(document.getElementById('bt-cap').value);
  const strategy = document.getElementById('bt-strat').value;
  const ticker = document.getElementById('bt-tick').value;
  const feesPct = parseFloat(document.getElementById('bt-fees').value) / 100;
  const st = STOCKS.find(x => x.ticker === ticker);
  const data = generateOHLCV(st.price, 365);
  const closes = data.map(d => d.close);

  let cash = capital, shares = 0, trades = 0, wins = 0;
  let maxEquity = capital, maxDD = 0;
  const equityCurve = [];

  for (let i = 50; i < closes.length; i++) {
    const price = closes[i];
    let signal = 0;

    if (strategy === 'sma_cross') {
      const sma20 = closes.slice(i - 20, i).reduce((a, b) => a + b) / 20;
      const sma50 = closes.slice(i - 50, i).reduce((a, b) => a + b) / 50;
      const prevSma20 = closes.slice(i - 21, i - 1).reduce((a, b) => a + b) / 20;
      const prevSma50 = closes.slice(i - 51, i - 1).reduce((a, b) => a + b) / 50;
      if (prevSma20 <= prevSma50 && sma20 > sma50) signal = 1;
      else if (prevSma20 >= prevSma50 && sma20 < sma50) signal = -1;
    } else if (strategy === 'rsi') {
      const gains = [], losses = [];
      for (let j = i - 14; j < i; j++) {
        const d = closes[j + 1] - closes[j];
        if (d > 0) gains.push(d); else losses.push(-d);
      }
      const avgGain = gains.length ? gains.reduce((a, b) => a + b, 0) / 14 : 0;
      const avgLoss = losses.length ? losses.reduce((a, b) => a + b, 0) / 14 : 0.001;
      const rs = avgGain / avgLoss;
      const rsi = 100 - 100 / (1 + rs);
      if (rsi < 30) signal = 1;
      else if (rsi > 70) signal = -1;
    } else if (strategy === 'momentum') {
      const mom = (closes[i] - closes[i - 20]) / closes[i - 20] * 100;
      if (mom > 3) signal = 1;
      else if (mom < -3) signal = -1;
    } else if (strategy === 'mean_reversion') {
      const sma = closes.slice(i - 20, i).reduce((a, b) => a + b) / 20;
      const variance = closes.slice(i - 20, i).reduce((s, p) => s + Math.pow(p - sma, 2), 0) / 20;
      const std = Math.sqrt(variance);
      const upper = sma + 2 * std;
      const lower = sma - 2 * std;
      if (price < lower) signal = 1;
      else if (price > upper) signal = -1;
    }

    if (signal === 1 && shares === 0 && cash > 0) {
      const qty = Math.floor(cash / (price * (1 + feesPct)));
      if (qty > 0) {
        shares = qty;
        cash -= qty * price * (1 + feesPct);
        trades++;
      }
    } else if (signal === -1 && shares > 0) {
      const entryPrice = (capital - cash) / shares / (1 + feesPct);
      cash += shares * price * (1 - feesPct);
      if (price > entryPrice) wins++;
      shares = 0;
      trades++;
    }

    const equity = cash + shares * price;
    equityCurve.push(equity);
    if (equity > maxEquity) maxEquity = equity;
    const dd = (maxEquity - equity) / maxEquity;
    if (dd > maxDD) maxDD = dd;
  }

  const finalValue = cash + shares * closes[closes.length - 1];
  const ret = ((finalValue - capital) / capital * 100);
  const winRate = trades > 0 ? (wins / Math.max(1, Math.floor(trades / 2)) * 100) : 0;
  const annualizedRet = ret * (252 / closes.length);

  document.getElementById('bt-res').innerHTML = `
    <div style="margin-bottom:8px"><b style="color:var(--accent)">${strategy}</b> sur <b style="color:var(--cyan)">${ticker}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Capital initial</span><b>${capital.toLocaleString('fr-FR')}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Valeur finale</span><b style="color:${finalValue >= capital ? 'var(--up)' : 'var(--down)'}">${finalValue.toFixed(0).toLocaleString('fr-FR')}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Rendement total</span><b style="color:${ret >= 0 ? 'var(--up)' : 'var(--down)'}">${ret >= 0 ? '+' : ''}${ret.toFixed(2)}%</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Rendement annualisé</span><b style="color:${annualizedRet >= 0 ? 'var(--up)' : 'var(--down)'}">${annualizedRet >= 0 ? '+' : ''}${annualizedRet.toFixed(2)}%</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Nombre de trades</span><b>${trades}</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border)"><span>Win Rate</span><b>${winRate.toFixed(0)}%</b></div>
    <div style="display:flex;justify-content:space-between;padding:3px 0"><span>Max Drawdown</span><b style="color:var(--down)">-${(maxDD * 100).toFixed(2)}%</b></div>
    <div style="margin-top:12px;color:var(--dim);font-size:9px">⚠ Simulation sur données générées. Ne constitue pas un conseil.</div>
  `;
  toast('✓ Backtest terminé');
}

