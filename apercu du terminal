document.getElementById('export-data').onclick = () => {
  const data = {
    predictions: PREDICTIONS,
    trades: TRADES,
    theme: currentTheme,
    chartType: chartType,
    exportDate: new Date().toISOString()
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
